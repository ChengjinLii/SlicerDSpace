# The same manifest drives development staging and SDK packaging.
function(slicerdsurfer_runtime_resources source_root output_variable)
  file(READ "${source_root}/scripts/extension_runtime/runtime_resources.json" spec)
  string(JSON version GET "${spec}" version)
  if(NOT version EQUAL 1)
    message(FATAL_ERROR "Unsupported runtime resource manifest version")
  endif()
  string(JSON file_count LENGTH "${spec}" files)
  math(EXPR last_file "${file_count} - 1")
  set(files)
  foreach(index RANGE ${last_file})
    string(JSON file GET "${spec}" files ${index})
    list(APPEND files "${file}")
  endforeach()
  string(JSON tree_count LENGTH "${spec}" trees)
  math(EXPR last_tree "${tree_count} - 1")
  foreach(index RANGE ${last_tree})
    string(JSON root GET "${spec}" trees ${index} root)
    string(JSON pattern_count LENGTH "${spec}" trees ${index} patterns)
    math(EXPR last_pattern "${pattern_count} - 1")
    foreach(pattern_index RANGE ${last_pattern})
      string(JSON pattern GET "${spec}" trees ${index} patterns ${pattern_index})
      file(GLOB_RECURSE matches LIST_DIRECTORIES false RELATIVE "${source_root}" "${source_root}/${root}/${pattern}")
      list(APPEND files ${matches})
    endforeach()
  endforeach()
  string(JSON component_count LENGTH "${spec}" excluded_components)
  math(EXPR last_component "${component_count} - 1")
  foreach(index RANGE ${last_component})
    string(JSON component GET "${spec}" excluded_components ${index})
    # Components are literal names; dots must not become regex wildcards.
    string(REPLACE "." "\\." component "${component}")
    list(FILTER files EXCLUDE REGEX "(^|/)${component}(/|$)")
  endforeach()
  string(JSON prefix_count LENGTH "${spec}" excluded_prefixes)
  math(EXPR last_prefix "${prefix_count} - 1")
  foreach(index RANGE ${last_prefix})
    string(JSON prefix GET "${spec}" excluded_prefixes ${index})
    list(FILTER files EXCLUDE REGEX "^${prefix}(/|$)")
  endforeach()
  string(JSON glob_count ERROR_VARIABLE glob_error LENGTH "${spec}" excluded_globs)
  if(NOT glob_error AND glob_count GREATER 0)
    math(EXPR last_glob "${glob_count} - 1")
    foreach(index RANGE ${last_glob})
      string(JSON pattern GET "${spec}" excluded_globs ${index})
      file(GLOB_RECURSE excluded LIST_DIRECTORIES false RELATIVE "${source_root}" "${source_root}/${pattern}")
      if(excluded)
        list(REMOVE_ITEM files ${excluded})
      endif()
    endforeach()
  endif()
  list(REMOVE_DUPLICATES files)
  list(SORT files)
  foreach(file IN LISTS files)
    if(NOT EXISTS "${source_root}/${file}")
      message(FATAL_ERROR "Required runtime resource is missing: ${file}")
    endif()
  endforeach()
  set(${output_variable} "${files}" PARENT_SCOPE)
endfunction()

# Standalone export is useful without an installed Slicer SDK.
if(DEFINED SLICERDDSURFER_RESOURCE_ROOT AND DEFINED SLICERDDSURFER_RESOURCE_OUTPUT)
  slicerdsurfer_runtime_resources("${SLICERDDSURFER_RESOURCE_ROOT}" files)
  string(REPLACE ";" "\n" files "${files}")
  file(WRITE "${SLICERDDSURFER_RESOURCE_OUTPUT}" "${files}\n")
endif()

# Explicit DDParcel/ACT compatibility protocol, not an unchanged author bundle
# protocol. Preserve the existing DDParcel AF endpoint CANDIDATES while using
# the pinned author's CST crossing/exclusion rules (no brainstem termination).
# Sampling QC is unchanged; anatomical identity still requires review.

import freesurfer_queries.qry

AF.side = (
    endpoints_in(
        ctx_parsopercularis.side or
        ctx_parsorbitalis.side or
        ctx_parstriangularis.side or
        ctx_caudalmiddlefrontal.side or
        ctx_rostralmiddlefrontal.side or
        ctx_precentral.side
    )
    and endpoints_in(
        ctx_superiortemporal.side or
        ctx_middletemporal.side
    )
)

# AF is a DDParcel-adapted endpoint candidate definition. CST follows the
# endpoint definition in the author's WMQL tutorial and 2016 paper, NOT the
# legacy freesurfer_queries.qry crossing/exclusion variant.
# https://tract-querier.readthedocs.io/en/latest/example_script.html
# Sampling QC and expert review are required before quantification.
#
# AF uses ctx_* labels. CST keeps the original FreeSurfer aliases, allowing
# either cortical-only DDParcel or genuine regional-WM parcellations.
# No endpoints, atlas labels or thresholds are dilated or relaxed.

import FreeSurfer.qry

AF.side = (
    endpoints_in(
        ctx_parsopercularis.side or
        ctx_parsorbitalis.side or
        ctx_parstriangularis.side or
        ctx_caudalmiddlefrontal.side or
        ctx_rostralmiddlefrontal.side or
        ctx_precentral.side
    )
    and endpoints_in(
        ctx_superiortemporal.side or
        ctx_middletemporal.side
    )
)

CST.side = (
    endpoints_in(Brain_Stem)
    and (endpoints_in(precentral.side) or endpoints_in(postcentral.side))
)

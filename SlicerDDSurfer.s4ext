# SlicerDDSurfer extension description for Slicer ExtensionsIndex submission.
# Keep `depends` synchronized with top-level CMakeLists.txt EXTENSION_DEPENDS.
scm git
scmurl https://github.com/ChengjinLii/SlicerDDSurfer.git
scmrevision main
depends SlicerDMRI PyTorch
build_subdirectory .
homepage https://github.com/ChengjinLii/SlicerDDSurfer
category Diffusion
contributors Chengjin Li
description Integrated diffusion MRI workflows for anatomical reconstruction, tractography, bundle analysis, and structural connectivity.
iconurl https://raw.githubusercontent.com/ChengjinLii/SlicerDDSurfer/main/Resources/Icons/SlicerDDSurfer.png
screenshoturls https://raw.githubusercontent.com/ChengjinLii/SlicerDDSurfer/main/docs/images/slicerdds-compact-en.png
enabled 1

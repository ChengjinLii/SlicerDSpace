         <widget class="QComboBox" name="unifiedTorchDeviceComboBox">
          <property name="toolTip">
           <string>auto uses cuda:0 when the selected Python/Slicer environment can see CUDA, otherwise CPU. Only one device path is run.</string>
          </property>
          <item>
           <property name="text">
            <string>auto</string>
           </property>
          </item>
          <item>
           <property name="text">
            <string>cpu</string>
           </property>
          </item>
          <item>
           <property name="text">
            <string>cuda:0</string>
           </property>
          </item>

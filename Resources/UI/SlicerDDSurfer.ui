             <property name="text">
              <string>Arrange inputs</string>
             </property>
            </widget>
           </item>
           <item row="5" column="1">
            <widget class="QComboBox" name="batchArrangeInputsComboBox">
             <property name="toolTip">
              <string>Optional. If raw files are directly inside each subject folder, create the required input/ folder by symlink or copy before running.</string>
             </property>
             <property name="SlicerParameterName" stdset="0">
              <string>batchArrangeInputs</string>
             </property>
             <item>
              <property name="text">
               <string>none</string>
              </property>
             </item>
             <item>
              <property name="text">
               <string>symlink</string>
              </property>
             </item>
             <item>
              <property name="text">
               <string>copy</string>
              </property>
             </item>
            </widget>
           </item>
          </layout>
         </item>
        </layout>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QFrame" name="runCollapsibleButton">
     <property name="frameShape">
      <enum>QFrame::NoFrame</enum>
     </property>
     <property name="toolTip">
      <string>Preflight checks, background execution, per-stage progress and cancellation.</string>
     </property>
     <layout class="QVBoxLayout" name="runLayout">
      <item>
       <layout class="QHBoxLayout" name="selectedActionsLayout">
        <item>
         <widget class="QPushButton" name="runSelectedButton">
          <property name="text">
           <string>Run SlicerDDSurfer</string>
          </property>
          <property name="toolTip">
           <string>Run enabled products from the shared subject root. The module checks dependencies first, installs missing Python packages only when enabled, then starts a monitored background job.</string>
          </property>
         </widget>
        </item>
       </layout>
      </item>
     </layout>
    </widget>
   </item>

             <item>
              <widget class="QCheckBox" name="orchestrationNoddiCheckBox">
               <property name="text"><string>NODDI</string></property>
               <property name="toolTip"><string>Optional NODDI model; off by default.</string></property>
              </widget>
             </item>
             <item>
              <widget class="QCheckBox" name="orchestrationDkiCheckBox">
               <property name="text"><string>DKI</string></property>
               <property name="toolTip"><string>Optional diffusion kurtosis analysis; off by default. Standard DKI is not MK-Curve.</string></property>
              </widget>
             </item>
            </layout>
           </item>
           <item>
            <widget class="QComboBox" name="orchestrationMicrostructureStagesComboBox">
             <property name="visible"><bool>false</bool></property>
             <property name="SlicerParameterName" stdset="0"><string>orchestrationMicrostructureStages</string></property>
             <item><property name="text"><string>dti</string></property></item>
             <item><property name="text"><string>dti,freewater</string></property></item>
             <item><property name="text"><string>dti,noddi</string></property></item>
             <item><property name="text"><string>dti,dki</string></property></item>
             <item><property name="text"><string>dti,freewater,noddi</string></property></item>
             <item><property name="text"><string>dti,freewater,dki</string></property></item>
             <item><property name="text"><string>dti,noddi,dki</string></property></item>
             <item><property name="text"><string>dti,freewater,noddi,dki</string></property></item>
            </widget>
           </item>
          </layout>
         </widget>
        </item>
        <item row="7" column="0">
         <widget class="QLabel" name="orchestrationDkiFitMethodLabel">
          <property name="text"><string>DKI fit method</string></property>
         </widget>
        </item>
        <item row="7" column="1">
         <widget class="QComboBox" name="orchestrationDkiFitMethodComboBox">
          <property name="SlicerParameterName" stdset="0"><string>orchestrationDkiFitMethod</string></property>
          <property name="toolTip">
           <string>WLS/OLS are standard DKI fits. MKCURVE is the bundled Python port; no MATLAB required. MKCURVE_MATLAB is an optional author-code reference backend requiring external paths. Multi-shell eligibility checks apply to all methods.</string>
          </property>
          <item><property name="text"><string>WLS</string></property></item>
          <item><property name="text"><string>OLS</string></property></item>
          <item><property name="text"><string>MKCURVE</string></property></item>
          <item><property name="text"><string>MKCURVE_MATLAB</string></property></item>
         </widget>
        </item>

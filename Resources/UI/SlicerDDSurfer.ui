         </property>
        </widget>
       </item>
       <item row="6" column="0">
        <widget class="QLabel" name="ddsegSlicerBaseLabel">
         <property name="text">
          <string>Slicer base</string>
         </property>
        </widget>
       </item>
       <item row="6" column="1">
        <widget class="ctkPathLineEdit" name="ddsegSlicerBasePath">
         <property name="filters">
          <set>ctkPathLineEdit::Dirs</set>
         </property>

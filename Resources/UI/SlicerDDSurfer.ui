  </item>
  <item>
   <widget class="ctkCollapsibleButton" name="infoCollapsibleButton">
     <property name="text">
      <string>Input Checklist</string>
     </property>
     <layout class="QVBoxLayout" name="infoLayout">
      <item>
       <widget class="QLabel" name="patternsLabel">
        <property name="styleSheet">
         <string notr="true">QLabel#patternsLabel { font-family: Menlo,Consolas,monospace; }</string>
        </property>
       <property name="text">
         <string>&lt;b&gt;Shared preferred input layout for DDSurfer, DDParcel, DDSeg, and Microstructure:&lt;/b&gt;&lt;ul&gt;&lt;li&gt;&lt;subject_root&gt;/input/data.nii.gz&lt;/li&gt;&lt;li&gt;&lt;subject_root&gt;/input/bvals&lt;/li&gt;&lt;li&gt;&lt;subject_root&gt;/input/bvecs&lt;/li&gt;&lt;li&gt;&lt;subject_root&gt;/input/nodif_brain_mask.nii.gz&lt;/li&gt;&lt;/ul&gt;&lt;b&gt;Cache reuse:&lt;/b&gt; DDSeg reads &lt;subject_root&gt;/cache/native_dti/ls, while DDSurfer, DDParcel, and Microstructure can reuse cached DTI outputs when available. Legacy DDSurfer Reg layouts are still accepted.</string>
        </property>
        <property name="textFormat">
         <enum>Qt::RichText</enum>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="ctkCollapsibleButton" name="logCollapsibleButton">
     <property name="text">
      <string>Pipeline Log</string>
     </property>
     <property name="collapsed">
      <bool>false</bool>
     </property>
     <layout class="QVBoxLayout" name="logLayout">
      <item>
       <layout class="QHBoxLayout" name="logToolbarLayout">
        <item>
         <widget class="QLabel" name="logHintLabel">
          <property name="styleSheet">
           <string notr="true">QLabel#logHintLabel { color: #607D8B; }</string>
          </property>
          <property name="text">
           <string>Messages appear as the pipeline runs.</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QPushButton" name="clearLogButton">
          <property name="styleSheet">

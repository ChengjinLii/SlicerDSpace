       <widget class="QLabel" name="microstructureHintLabel">
        <property name="styleSheet">
         <string notr="true">QLabel#microstructureHintLabel { color: #546E7A; }</string>
        </property>
        <property name="text">
         <string>Export native-space DTI scalar maps and run selected optional microstructure models. If ROI labels are left empty, use &lt;subject_root&gt;/outputs/03_anatomy/ddparcel, with compatible reading of existing 03_structural products. Each enabled model checks its acquisition requirements; optional multi-shell models are not run on ineligible data. Model outputs and cache records are kept separately for selective reruns.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>

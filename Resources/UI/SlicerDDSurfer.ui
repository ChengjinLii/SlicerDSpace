      </item>
      <item>
       <widget class="ctkCollapsibleButton" name="advancedRunCollapsibleButton">
        <property name="text">
         <string>Analysis settings</string>
        </property>
        <property name="collapsed">
         <bool>true</bool>
        </property>
        <layout class="QVBoxLayout" name="advancedRunCollapsibleLayout">

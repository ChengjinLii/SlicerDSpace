          <widget class="QLabel" name="advancedRunSectionLabel">
           <property name="wordWrap">
            <bool>true</bool>
           </property>
           <property name="text">
            <string>Defaults suit most runs. Change the run name to keep results side by side; use batch mode for a study folder.</string>
           </property>
          </widget>
         </item>
         <item>
          <layout class="QFormLayout" name="advancedRunFormLayout">
           <property name="rowWrapPolicy">
            <enum>QFormLayout::WrapLongRows</enum>
           </property>
           <property name="fieldGrowthPolicy">
            <enum>QFormLayout::AllNonFixedFieldsGrow</enum>
           </property>
           <item row="0" column="0">
            <widget class="QLabel" name="orchestrationRunNameLabel">
             <property name="text">
              <string>Run name</string>
             </property>
            </widget>
           </item>
           <item row="0" column="1">
            <widget class="QLineEdit" name="orchestrationRunNameLineEdit">
             <property name="toolTip">
              <string>Used to group tractography, bundle, connectome, and run-metadata outputs. Example: csd_act_100k.</string>
             </property>
             <property name="placeholderText">
              <string>Test1</string>
             </property>
             <property name="SlicerParameterName" stdset="0">
              <string>orchestrationRunName</string>
             </property>
            </widget>
           </item>
           <item row="1" column="0">
            <widget class="QLabel" name="orchestrationSelectStreamlinesLabel">
             <property name="text">
              <string>ACT/SAF streamlines (count)</string>
             </property>
            </widget>
           </item>
           <item row="1" column="1">
            <widget class="QSpinBox" name="orchestrationSelectStreamlinesSpinBox">
             <property name="toolTip">
              <string>Number of selected streamlines requested from MRtrix CSD/ACT. One million is recommended for bundle analysis and connectome construction.</string>
             </property>
             <property name="minimum">
              <number>1</number>
             </property>
             <property name="maximum">
              <number>10000000</number>
             </property>
             <property name="value">
              <number>1000000</number>
             </property>
             <property name="SlicerParameterName" stdset="0">
              <string>orchestrationSelectStreamlines</string>
             </property>
            </widget>
           </item>
           <item row="6" column="0">
            <widget class="QLabel" name="parallelModelsLabel">
             <property name="text"><string>Concurrent microstructure models</string></property>
            </widget>
           </item>
           <item row="6" column="1">
            <widget class="QSpinBox" name="parallelModelsSpinBox">
             <property name="minimum"><number>1</number></property>
             <property name="maximum"><number>3</number></property>
             <property name="value"><number>1</number></property>
             <property name="toolTip"><string>1 keeps sequential execution. 2 or 3 allows independent Free-water, NODDI and DKI fits to overlap after input preparation. CPU and memory budgets limit actual overlap; ROI tables are written once afterward. Does not change GPU selection.</string></property>
             <property name="SlicerParameterName" stdset="0"><string>maxParallelModels</string></property>
            </widget>
           </item>
           <item row="2" column="0">
            <widget class="QLabel" name="batchModeLabel">
             <property name="text">
              <string>Batch mode</string>
             </property>
            </widget>
           </item>
           <item row="2" column="1">
            <widget class="QCheckBox" name="batchModeCheckBox">
             <property name="toolTip">
              <string>Run the selected product set for every detected subject under Batch root. Subject ID is inferred from each child directory.</string>
             </property>
             <property name="text">
              <string>Process all subjects under a study root</string>
             </property>
             <property name="SlicerParameterName" stdset="0">
              <string>batchMode</string>
             </property>
            </widget>
           </item>
           <item row="3" column="0">
            <widget class="QLabel" name="batchRootLabel">
             <property name="text">
              <string>Batch root</string>
             </property>
            </widget>
           </item>
           <item row="3" column="1">
            <widget class="ctkPathLineEdit" name="batchRootPath">
             <property name="filters">
              <set>ctkPathLineEdit::Dirs</set>
             </property>
             <property name="placeholderText" stdset="0">
              <string>Directory containing one subject folder per child directory</string>
             </property>
            </widget>
           </item>
           <item row="4" column="0">
            <widget class="QLabel" name="batchSizeLabel">
             <property name="text">
              <string>Batch size</string>
             </property>
            </widget>
           </item>
           <item row="4" column="1">
            <widget class="QSpinBox" name="batchSizeSpinBox">
             <property name="toolTip">
              <string>Maximum number of subjects to run concurrently. Use 1 for safest GPU/CPU memory behavior.</string>
             </property>
             <property name="minimum">
              <number>1</number>
             </property>
             <property name="maximum">
              <number>64</number>
             </property>
             <property name="value">
              <number>1</number>
             </property>
             <property name="SlicerParameterName" stdset="0">
              <string>batchSize</string>
             </property>
            </widget>
           </item>
           <item row="5" column="0">

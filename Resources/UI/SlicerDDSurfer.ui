          <string>Subject directory / DWI</string>
         </property>
        </widget>
       </item>
       <item row="0" column="1">
        <widget class="ctkPathLineEdit" name="ddsegDwiPath">
         <property name="filters">
          <set>ctkPathLineEdit::Dirs|ctkPathLineEdit::Files</set>
         </property>
         <property name="placeholderText" stdset="0">
          <string>Preferred: &lt;subject_root&gt;; legacy mode: raw data.nii.gz</string>
         </property>
        </widget>
       </item>
       <item row="1" column="0">
        <widget class="QLabel" name="ddsegMaskLabel">
         <property name="text">
          <string>Mask NIfTI</string>
         </property>
        </widget>
       </item>
       <item row="1" column="1">
        <widget class="ctkPathLineEdit" name="ddsegMaskPath">
         <property name="filters">
          <set>ctkPathLineEdit::Files</set>
         </property>
         <property name="placeholderText" stdset="0">
          <string>Legacy mode only. Leave empty in subject-root mode.</string>
         </property>
        </widget>
       </item>
       <item row="2" column="0">
        <widget class="QLabel" name="ddsegBvalLabel">
         <property name="text">
          <string>bvals</string>
         </property>
        </widget>
       </item>
       <item row="2" column="1">
        <widget class="ctkPathLineEdit" name="ddsegBvalPath">
         <property name="filters">
          <set>ctkPathLineEdit::Files</set>
         </property>
         <property name="placeholderText" stdset="0">
          <string>Legacy mode only. Leave empty in subject-root mode.</string>
         </property>
        </widget>
       </item>
       <item row="3" column="0">
        <widget class="QLabel" name="ddsegBvecLabel">
         <property name="text">
          <string>bvecs</string>
         </property>
        </widget>
       </item>
       <item row="3" column="1">
        <widget class="ctkPathLineEdit" name="ddsegBvecPath">
         <property name="filters">
          <set>ctkPathLineEdit::Files</set>
         </property>
         <property name="placeholderText" stdset="0">
          <string>Legacy mode only. Leave empty in subject-root mode.</string>
         </property>
        </widget>
       </item>
       <item row="4" column="0">
        <widget class="QLabel" name="ddsegOutputLabel">
         <property name="text">
          <string>Output directory</string>
         </property>
        </widget>
       </item>
       <item row="4" column="1">
        <widget class="ctkPathLineEdit" name="ddsegOutputPath">
         <property name="filters">
          <set>ctkPathLineEdit::Dirs</set>
         </property>
         <property name="placeholderText" stdset="0">
          <string>Optional in subject-root mode. Defaults to &lt;subject_root&gt;/outputs/03_structural/ddseg</string>
         </property>
        </widget>
       </item>
       <item row="5" column="0">
        <widget class="QLabel" name="ddsegWeightsLabel">
         <property name="text">
          <string>Weights directory</string>
         </property>
        </widget>
       </item>
       <item row="5" column="1">
        <widget class="ctkPathLineEdit" name="ddsegWeightsPath">
         <property name="filters">
          <set>ctkPathLineEdit::Dirs</set>
         </property>
         <property name="placeholderText" stdset="0">

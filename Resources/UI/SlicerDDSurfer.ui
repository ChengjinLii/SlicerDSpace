       </item>
      </layout>
     </item>
     <item>
      <widget class="QPushButton" name="runDDSegButton">
       <property name="text">
        <string>Run DDSeg</string>
       </property>
       <property name="toolTip">
        <string>Run DDSeg from a subject-root cache or from explicit raw DWI inputs.</string>
       </property>
       <property name="styleSheet">
        <string notr="true">QPushButton#runDDSegButton { background-color: #00ACC1; color: white; font-weight: 600; border-radius: 6px; padding: 6px 14px; } QPushButton#runDDSegButton:disabled { background-color: #CFD8DC; color: #90A4AE; } QPushButton#runDDSegButton:hover:!disabled { background-color: #00838F; }</string>
       </property>

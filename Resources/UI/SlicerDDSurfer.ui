         <widget class="QLabel" name="autoInstallPythonDependenciesLabel">
          <property name="text">
           <string>Missing Python deps</string>
          </property>
         </widget>
        </item>
        <item row="1" column="1">
         <widget class="QCheckBox" name="autoInstallPythonDependenciesCheckBox">
          <property name="text">
           <string>Install missing Python packages before running</string>
          </property>
          <property name="toolTip">
           <string>Missing Python packages are installed in the background. Review setup, then click Run SlicerDDSurfer again. External tools are not installed silently.</string>
          </property>
          <property name="checked">
           <bool>true</bool>
          </property>
          <property name="SlicerParameterName" stdset="0">
           <string>autoInstallPythonDependencies</string>
          </property>
         </widget>
        </item>
        <item row="2" column="1">
         <widget class="QPushButton" name="validateButton">
          <property name="toolTip">
           <string>Check dependency availability and write the install plan for the currently selected products. Subject inputs are checked automatically before running.</string>
          </property>
          <property name="text">
           <string>Check environment dependencies</string>
          </property>
         </widget>
        </item>
       </layout>
      </item>
      <item>
       <widget class="QLabel" name="environmentResultLabel">
        <property name="text">
         <string>No environment check has been run yet.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>

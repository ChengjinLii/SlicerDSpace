         </property>
        </widget>
       </item>
       <item row="5" column="1">
        <widget class="QComboBox" name="postprocessModeComboBox">
         <item>
          <property name="text">
           <string>whole</string>
          </property>
         </item>
         <item>
          <property name="text">
           <string>left</string>
          </property>
         </item>
         <item>
          <property name="text">
           <string>right</string>
          </property>
         </item>
        </widget>
       </item>
       <item row="6" column="0">
        <widget class="QLabel" name="dockerImageLabel">
         <property name="text">
          <string>Docker image tag</string>
         </property>
        </widget>
       </item>
       <item row="6" column="1">
        <widget class="QLineEdit" name="postprocessImageLineEdit">
         <property name="placeholderText">
          <string>Optional (defaults to dds_postprocess:latest)</string>
         </property>
        </widget>
       </item>
       <item row="7" column="0">
        <widget class="QLabel" name="dockerForceLabel">
         <property name="text">
          <string>Stage inputs</string>
         </property>
        </widget>
       </item>
       <item row="7" column="1">
        <widget class="QCheckBox" name="postprocessForceCheckBox">
         <property name="text">
          <string>Overwrite staged inputs</string>
         </property>
         <property name="checked">
          <bool>true</bool>
         </property>
        </widget>
       </item>
      </layout>
     </item>
     <item>
      <widget class="QPushButton" name="runPostprocessButton">
       <property name="text">
        <string>Run Docker Postprocess</string>
       </property>
       <property name="toolTip">
        <string>Stage inputs and launch docker/run_container.sh</string>
       </property>
       <property name="styleSheet">
        <string notr="true">QPushButton#runPostprocessButton { background-color: #00ACC1; color: white; font-weight: 600; border-radius: 6px; padding: 6px 14px; } QPushButton#runPostprocessButton:disabled { background-color: #CFD8DC; color: #90A4AE; } QPushButton#runPostprocessButton:hover:!disabled { background-color: #00838F; }</string>
       </property>
      </widget>
     </item>
    </layout>
   </widget>
  </item>
  <item>
   <widget class="ctkCollapsibleButton" name="ddparcelCollapsibleButton">
    <property name="text">
     <string>2. Parcellation: DDParcel</string>
    </property>
    <property name="collapsed">
     <bool>true</bool>
    </property>
    <layout class="QVBoxLayout" name="ddparcelLayout">
     <item>
      <widget class="QLabel" name="ddparcelSectionLabel">
       <property name="text">
        <string>&lt;b&gt;Shared-cache consumer&lt;/b&gt;</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QLabel" name="ddparcelHintLabel">
       <property name="styleSheet">
        <string notr="true">QLabel#ddparcelHintLabel { color: #546E7A; }</string>
       </property>
       <property name="text">
        <string>Run DDParcel from the same subject directory layout used by DDSurfer. If cached registered DTI features already exist, they will be reused automatically.</string>
        </property>
       <property name="wordWrap">
        <bool>true</bool>
       </property>
      </widget>
     </item>
     <item>
     <layout class="QFormLayout" name="ddparcelFormLayout">
       <item row="0" column="0">
        <widget class="QLabel" name="ddparcelSubjectLabel">
         <property name="text">
          <string>Subject ID</string>
         </property>
        </widget>
       </item>
       <item row="0" column="1">
        <widget class="QLineEdit" name="ddparcelSubjectLineEdit">
         <property name="placeholderText">
          <string>Leave empty to reuse DDSurfer subject</string>
         </property>
        </widget>
       </item>
       <item row="1" column="0">
        <widget class="QLabel" name="ddparcelScriptLabel">
         <property name="text">
          <string>Subject directory</string>
         </property>
        </widget>
       </item>
       <item row="1" column="1">
        <widget class="ctkPathLineEdit" name="ddparcelInputRootPath">
         <property name="filters">
         <set>ctkPathLineEdit::Dirs</set>
         </property>
         <property name="placeholderText" stdset="0">
          <string>Preferred: &lt;subject_root&gt; containing input/data.nii.gz; legacy DDParcel roots also supported</string>
         </property>
        </widget>
       </item>
       <item row="2" column="0">
        <widget class="QLabel" name="ddparcelOutputRootLabel">
         <property name="text">
          <string>Output directory</string>
         </property>
        </widget>
       </item>
       <item row="2" column="1">
        <widget class="ctkPathLineEdit" name="ddparcelOutputRootPath">
         <property name="filters">
         <set>ctkPathLineEdit::Dirs</set>
         </property>
         <property name="placeholderText" stdset="0">
          <string>Optional. Defaults to &lt;subject_root&gt;/outputs/03_structural/ddparcel</string>
         </property>
        </widget>
       </item>
       <item row="3" column="0">
        <widget class="QLabel" name="ddparcelAtlasLabel">
         <property name="text">
          <string>Atlas T2</string>
         </property>
        </widget>
       </item>
       <item row="3" column="1">
        <widget class="ctkPathLineEdit" name="ddparcelAtlasPath">
         <property name="filters">
          <set>ctkPathLineEdit::Files</set>
         </property>
         <property name="placeholderText" stdset="0">
          <string>Path to atlas T2 NIfTI</string>
         </property>
        </widget>
       </item>
       <item row="4" column="0">
        <widget class="QLabel" name="ddparcelFlipLabel">
         <property name="text">
          <string>Mask flip</string>
         </property>
        </widget>
       </item>
       <item row="4" column="1">
        <widget class="QSpinBox" name="ddparcelFlipSpinBox">
         <property name="minimum">
          <number>0</number>
         </property>
         <property name="maximum">
          <number>2</number>
         </property>
         <property name="value">
          <number>1</number>
         </property>
        </widget>
       </item>
      </layout>
     </item>
     <item>
      <widget class="QPushButton" name="runDDParcelButton">
       <property name="text">
        <string>Run DDParcel</string>
       </property>
      <property name="toolTip">
        <string>Run DDParcel using the shared subject-root cache when available.</string>
       </property>
       <property name="styleSheet">
        <string notr="true">QPushButton#runDDParcelButton { background-color: #00ACC1; color: white; font-weight: 600; border-radius: 6px; padding: 6px 14px; } QPushButton#runDDParcelButton:disabled { background-color: #CFD8DC; color: #90A4AE; } QPushButton#runDDParcelButton:hover:!disabled { background-color: #00838F; }</string>
       </property>
      </widget>
     </item>
    </layout>
   </widget>
  </item>
  <item>
   <widget class="ctkCollapsibleButton" name="microstructureCollapsibleButton">
   <property name="text">
     <string>4. Microstructure</string>
    </property>
    <property name="collapsed">
     <bool>true</bool>
    </property>
    <layout class="QVBoxLayout" name="microstructureLayout">
     <item>
      <widget class="QLabel" name="microstructureSectionLabel">
       <property name="text">
        <string>&lt;b&gt;FA / MD + Free Water + NODDI + ROI-wise stats&lt;/b&gt;</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QLabel" name="microstructureHintLabel">
       <property name="styleSheet">
        <string notr="true">QLabel#microstructureHintLabel { color: #546E7A; }</string>
       </property>
       <property name="text">
        <string>Export native-space FA and MD from the shared DTI cache, fit a DIPY Free Water model from the raw DWI, fit AMICO NODDI maps, and compute ROI-wise FA / MD / FWF / corrected tissue FA / corrected tissue MD / NDI / ODI / NODDI FWF. If ROI label map is left empty, the workflow will try &lt;subject_root&gt;/outputs/03_structural/ddparcel/&lt;subject&gt;-DDSurfer-wmparc.nii.gz. Multi-shell DWI is required. Free Water and NODDI are cached as separate stages, so reruns can selectively recompute only the stage you enable. For stability on this environment, AMICO NODDI runs with a single worker thread (nthreads=1).</string>
       </property>
       <property name="wordWrap">
        <bool>true</bool>
       </property>
      </widget>
     </item>
     <item>
      <layout class="QFormLayout" name="microstructureFormLayout">
       <item row="0" column="0">
        <widget class="QLabel" name="microstructureSubjectLabel">
         <property name="text">
          <string>Subject ID</string>
         </property>
        </widget>
       </item>
       <item row="0" column="1">
        <widget class="QLineEdit" name="microstructureSubjectLineEdit">
         <property name="placeholderText">
          <string>Leave empty to reuse DDSurfer subject</string>
         </property>
        </widget>
       </item>
       <item row="1" column="0">
        <widget class="QLabel" name="microstructureInputLabel">
         <property name="text">
          <string>Subject directory</string>
         </property>
        </widget>
       </item>
       <item row="1" column="1">
        <widget class="ctkPathLineEdit" name="microstructureInputRootPath">
         <property name="filters">
          <set>ctkPathLineEdit::Dirs</set>
         </property>
         <property name="placeholderText" stdset="0">
          <string>Preferred: &lt;subject_root&gt; containing input/data.nii.gz</string>
         </property>
        </widget>
       </item>
       <item row="2" column="0">
        <widget class="QLabel" name="microstructureOutputLabel">
         <property name="text">
          <string>Output directory</string>
         </property>
        </widget>
       </item>
       <item row="2" column="1">
        <widget class="ctkPathLineEdit" name="microstructureOutputPath">
         <property name="filters">
          <set>ctkPathLineEdit::Dirs</set>
         </property>
         <property name="placeholderText" stdset="0">
          <string>Optional. Defaults to &lt;subject_root&gt;/outputs/02_microstructure</string>
         </property>
        </widget>
       </item>
       <item row="3" column="0">
        <widget class="QLabel" name="microstructureRoiLabel">
         <property name="text">
          <string>ROI label map</string>
         </property>
        </widget>
       </item>
       <item row="3" column="1">
        <widget class="ctkPathLineEdit" name="microstructureRoiPath">
         <property name="filters">
          <set>ctkPathLineEdit::Files</set>
         </property>
         <property name="placeholderText" stdset="0">
          <string>Optional. Defaults to DDParcel native wmparc output when present.</string>
         </property>
        </widget>
       </item>
       <item row="4" column="0">
        <widget class="QLabel" name="microstructureFitLabel">
         <property name="text">
          <string>DTI fit cache</string>
         </property>
        </widget>
       </item>
       <item row="4" column="1">
       <widget class="QComboBox" name="microstructureFitComboBox">
         <item>
          <property name="text">
           <string>wls</string>
          </property>
         </item>
         <item>
          <property name="text">
           <string>ls</string>
          </property>
         </item>
        </widget>
       </item>
       <item row="5" column="0">
        <widget class="QLabel" name="microstructureRunFreeWaterLabel">
         <property name="text">
          <string>Run Free Water</string>
         </property>
        </widget>
       </item>
       <item row="5" column="1">
        <widget class="QCheckBox" name="microstructureRunFreeWaterCheckBox">
         <property name="checked">
          <bool>true</bool>
         </property>
         <property name="text">
          <string>Enabled</string>
         </property>
         <property name="toolTip">
          <string>When disabled, existing Free Water maps must already exist in the output folder.</string>
         </property>
        </widget>
       </item>
       <item row="6" column="0">
        <widget class="QLabel" name="microstructureRunNoddiLabel">
         <property name="text">
          <string>Run NODDI</string>
         </property>
        </widget>
       </item>
       <item row="6" column="1">
        <widget class="QCheckBox" name="microstructureRunNoddiCheckBox">
         <property name="checked">
          <bool>true</bool>
         </property>
         <property name="text">
          <string>Enabled</string>
         </property>
         <property name="toolTip">
          <string>When disabled, existing NODDI maps must already exist in the output folder.</string>
         </property>
        </widget>
       </item>
       <item row="7" column="0">
        <widget class="QLabel" name="microstructureForceRecomputeLabel">
         <property name="text">
          <string>Force recompute</string>
         </property>
        </widget>
       </item>
       <item row="7" column="1">
        <widget class="QCheckBox" name="microstructureForceRecomputeCheckBox">
         <property name="checked">
          <bool>false</bool>
         </property>
         <property name="text">
          <string>Enabled</string>
         </property>
         <property name="toolTip">
          <string>Recompute selected stages even when cache manifest matches.</string>
         </property>
        </widget>
       </item>
      </layout>
     </item>
     <item>
      <widget class="QPushButton" name="runMicrostructureButton">
       <property name="text">
        <string>Run Microstructure</string>
       </property>
       <property name="toolTip">
        <string>Export FA/MD, run selected Free Water/NODDI stages with cache reuse, and compute ROI-wise microstructure statistics from shared subject-root inputs.</string>
       </property>
       <property name="styleSheet">
        <string notr="true">QPushButton#runMicrostructureButton { background-color: #00ACC1; color: white; font-weight: 600; border-radius: 6px; padding: 6px 14px; } QPushButton#runMicrostructureButton:disabled { background-color: #CFD8DC; color: #90A4AE; } QPushButton#runMicrostructureButton:hover:!disabled { background-color: #00838F; }</string>
       </property>
      </widget>
     </item>
    </layout>
   </widget>
  </item>
  <item>
   <widget class="ctkCollapsibleButton" name="ddsegCollapsibleButton">
    <property name="text">
     <string>3. Segmentation: DDSeg</string>
    </property>
    <property name="collapsed">
     <bool>true</bool>
    </property>
    <layout class="QVBoxLayout" name="ddsegLayout">
     <item>
      <widget class="QLabel" name="ddsegSectionLabel">
       <property name="text">
        <string>&lt;b&gt;WM / GM / CSF segmentation&lt;/b&gt;</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QLabel" name="ddsegHintLabel">
       <property name="styleSheet">
        <string notr="true">QLabel#ddsegHintLabel { color: #546E7A; }</string>
       </property>
       <property name="text">
        <string>Preferred mode: choose the same &lt;subject_root&gt; in the “Subject directory / DWI” field and leave mask, bval, and bvec empty. DDSeg will reuse cache/native_dti/ls automatically. Legacy raw-file mode is still supported below.</string>
       </property>
       <property name="wordWrap">
        <bool>true</bool>
       </property>
      </widget>
     </item>
     <item>
      <layout class="QFormLayout" name="ddsegFormLayout">
       <item row="0" column="0">
        <widget class="QLabel" name="ddsegDwiLabel">

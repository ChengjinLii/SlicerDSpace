         <string>Run preflight before execution. Python packages can be installed on demand; external tools such as MRtrix3, FSL, FreeSurfer, WMA, and TractCloud are reported with setup notes and do not silently mutate your system.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>

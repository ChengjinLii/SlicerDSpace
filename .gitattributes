# Auto detect text files and perform LF normalization
* text=auto
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf
*.csh text eol=lf
*.tcsh text eol=lf
*.conf text eol=lf
# Preserve the exact upstream bytes used by license provenance checks.
anatomy/parcellation/conversion/LICENSE.txt text eol=lf
anatomy/surface/ddsurfer_backend/LICENSE.txt text eol=lf
licenses/FreeSurfer.txt text eol=lf
licenses/PyTorch3D.txt text eol=lf
*.pt filter=lfs diff=lfs merge=lfs -text
*.pkl filter=lfs diff=lfs merge=lfs -text
*.nii.gz filter=lfs diff=lfs merge=lfs -text
*.mgz filter=lfs diff=lfs merge=lfs -text
*.tck filter=lfs diff=lfs merge=lfs -text
*.trk filter=lfs diff=lfs merge=lfs -text
*.vtk filter=lfs diff=lfs merge=lfs -text
*.vtp filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text
*.stl filter=lfs diff=lfs merge=lfs -text

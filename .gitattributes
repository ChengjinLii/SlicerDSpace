# Auto detect text files and perform LF normalization
* text=auto
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf
*.csh text eol=lf
*.tcsh text eol=lf
*.conf text eol=lf
# Preserve the exact upstream bytes used by license provenance checks.
anatomy/parcellation/conversion/LICENSE.txt text eol=lf
anatomy/surface/ddsurfer_backend/LICENSE.txt text eol=lf
licenses/FreeSurfer.txt text eol=lf
licenses/PyTorch3D.txt text eol=lf
licenses/MK-Curve-LICENSE.txt text eol=lf
licenses/MK-Curve-DKI-MPL-2.0.txt text eol=lf
licenses/WMA.txt text eol=lf
licenses/DIPY.txt text eol=lf
# Keep pinned author WMQL rules byte-for-byte, including upstream whitespace.
tractography/wmql_queries/official/*.qry -text whitespace=-blank-at-eol,-blank-at-eof
# Preserve contributed upstream font-license bytes, including their original CRLF/spacing.
docs/site/assets/fonts/OFL-*.txt -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
docs/website/SPEC.md whitespace=-blank-at-eof
# Manuscript source/material receipts verify exact bytes across checkouts.
docs/paper/** -text
docs/paper/evidence/*.csv whitespace=cr-at-eol
docs/paper/evidence/box_quantification/*.csv whitespace=cr-at-eol
docs/paper/sn-nature.bst whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
# Matplotlib preserves line separators inside SVG path data.
docs/paper/figures/box_regional_results.svg whitespace=-blank-at-eol
*.pt filter=lfs diff=lfs merge=lfs -text
*.pkl filter=lfs diff=lfs merge=lfs -text
*.nii.gz filter=lfs diff=lfs merge=lfs -text
*.mgz filter=lfs diff=lfs merge=lfs -text
*.tck filter=lfs diff=lfs merge=lfs -text
*.trk filter=lfs diff=lfs merge=lfs -text
*.vtk filter=lfs diff=lfs merge=lfs -text
*.vtp filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text
*.stl filter=lfs diff=lfs merge=lfs -text

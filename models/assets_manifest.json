  "profiles": {
    "sentinel": {
      "description": "Tiny connectivity check for the model-asset downloader and public mirror without downloading model weights.",
      "asset_groups": [
        "download sentinel"
      ],
      "required_paths": [
        "sentinel/slicerdsurfer_sentinel.txt"
      ]
    },
    "surface": {
      "description": "Manifest-configured DDSurfer TANet weights, transformed templates and 1-mm atlas.",
      "asset_groups": [
        "DDSurfer TANet surface model weights",
        "1-mm registration atlas",
        "transformed surface initialization meshes"
      ],
      "terms_notice": [
        "DDCSR surface weights, HCP-like templates, surface initialization meshes, and subject-derived FA examples are provided through the external SlicerDDSurfer-models asset source, but public redistribution and DOI-archive terms require author confirmation before manuscript submission.",
        "If redistribution terms cannot be confirmed, document an alternate access route in Data and Code Availability."
      ],
      "include_patterns": [
        "surface/weights/**",
        "surface/template/**"
      ],
      "required_paths": [
        "surface/weights/manifest.json",
        "surface/weights/SHA256SUMS",
        "surface/weights/ddsurfer_lh_wm.pt",
        "surface/weights/ddsurfer_rh_wm.pt",
        "surface/weights/ddsurfer_lh_pial.pt",
        "surface/weights/ddsurfer_rh_pial.pt",
        "surface/template/ddsurfer_lh_template.obj",
        "surface/template/ddsurfer_rh_template.obj",
        "surface/template/100HCP-population-mean-T2-1mm.nii.gz"
      ],
      "external_overrides": [
        "DDSURFER_CHECKPOINT_DIR",
        "DDSURFER_TEMPLATE_DIR",
        "DDSURFER_REGISTRATION_ATLAS"
      ],
      "terms_notices": [
        "DDSurfer weights, transformed templates and the 1-mm atlas are mirrored from the recorded upstream revision. Public redistribution and DOI-archive terms require author confirmation before publication.",
        "Subject-level diffusion data are not bundled with this profile."
      ]
    },
    "segmentation": {
      "description": "DDSeg DTI multi-view CNN weights.",
      "asset_groups": [
        "DDSeg tissue-segmentation weights"
      ],
      "terms_notice": [
        "DDSeg weights are needed for segmentation. Confirm redistribution terms and cite the peer-reviewed DDSeg method paper before treating these weights as unrestricted public assets."
      ],
      "include_patterns": [
        "segmentation/weights/**"
      ],
      "required_paths": [
        "segmentation/weights/dti_axial.pt",
        "segmentation/weights/dti_coronal.pt",
        "segmentation/weights/dti_sagittal.pt"
      ]
    },
    "parcellation": {
      "description": "DDParcel fused U-Net and diffusion-backbone weights.",
      "asset_groups": [
        "DDParcel parcellation weights"
      ],
      "terms_notice": [

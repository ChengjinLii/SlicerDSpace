{
  "kind": "slicerdsurfer_model_asset_manifest",
  "version": 1,
  "default_profile": "core",
  "profiles": {
    "surface": {
      "description": "DDSurfer checkpoints, surface templates, and registration atlas.",
      "include_patterns": [
        "Resources/Data/100HCP-population-mean-T2.nii.gz",
        "Resources/Data/ckpts/hcp/**",
        "Resources/Data/template/**",
        "surface/template/**"
      ],
      "required_paths": [
        "Resources/Data/100HCP-population-mean-T2.nii.gz",
        "Resources/Data/ckpts/hcp/DDCSR_pial_lh_Full_DualStream_no_b0_Cascaded.pt",
        "Resources/Data/ckpts/hcp/DDCSR_pial_rh_Full_DualStream_no_b0_Cascaded.pt",
        "Resources/Data/ckpts/hcp/DDCSR_white_lh_Full_DualStream_no_b0_Cascaded.pt",
        "Resources/Data/ckpts/hcp/DDCSR_white_rh_Full_DualStream_no_b0_Cascaded.pt",
        "Resources/Data/template/100307-FA.nii.gz",
        "Resources/Data/template/hcp_hemi-left_init_160k.obj",
        "Resources/Data/template/hcp_hemi-right_init_160k.obj",
        "surface/template/100307-FA.nii.gz",
        "surface/template/hcp_hemi-left_init_160k.obj",
        "surface/template/hcp_hemi-right_init_160k.obj"
      ],
      "external_overrides": [
        "DDSURFER_CHECKPOINT_DIR",
        "DDSURFER_TEMPLATE_DIR",
        "DDSURFER_REGISTRATION_ATLAS"
      ]
    },
    "segmentation": {
      "description": "DDSeg DTI multi-view CNN weights.",
      "include_patterns": [
        "segmentation/weights/**"
      ],
      "required_paths": [
        "segmentation/weights/dti_axial.pt",
        "segmentation/weights/dti_coronal.pt",
        "segmentation/weights/dti_sagittal.pt"
      ]
    },
    "parcellation": {
      "description": "DDParcel fused U-Net and diffusion-backbone weights.",
      "include_patterns": [
        "parcellation/weights/**"
      ],
      "required_paths": [
        "parcellation/weights/Fused-Unet-v3-noMax-axial.pkl",
        "parcellation/weights/Fused-Unet-v3-noMax-coronal.pkl",
        "parcellation/weights/Fused-Unet-v3-noMax-sagittal.pkl",
        "parcellation/weights/backbones/dti-FractionalAnisotropy-reg-NormMasked-axial.pkl",
        "parcellation/weights/backbones/dti-FractionalAnisotropy-reg-NormMasked-coronal.pkl",
        "parcellation/weights/backbones/dti-FractionalAnisotropy-reg-NormMasked-sagittal.pkl",
        "parcellation/weights/backbones/dti-MidEigenvalue-reg-NormMasked-axial.pkl",
        "parcellation/weights/backbones/dti-MidEigenvalue-reg-NormMasked-coronal.pkl",
        "parcellation/weights/backbones/dti-MidEigenvalue-reg-NormMasked-sagittal.pkl",
        "parcellation/weights/backbones/dti-MinEigenvalue-reg-NormMasked-axial.pkl",
        "parcellation/weights/backbones/dti-MinEigenvalue-reg-NormMasked-coronal.pkl",
        "parcellation/weights/backbones/dti-MinEigenvalue-reg-NormMasked-sagittal.pkl",
        "parcellation/weights/backbones/dti-Trace-reg-NormMasked-axial.pkl",
        "parcellation/weights/backbones/dti-Trace-reg-NormMasked-coronal.pkl",
        "parcellation/weights/backbones/dti-Trace-reg-NormMasked-sagittal.pkl"
      ]
    },
    "core": {
      "description": "Recommended local-user profile: surface + segmentation + parcellation.",
      "include_profiles": [
        "surface",
        "segmentation",
        "parcellation"
      ]
    },
    "quick-gate": {
      "description": "Release quick-gate alias for core.",
      "alias_for": "core"
    },
    "test-fixtures": {
      "description": "Parcellation conversion test fixture data.",
      "include_patterns": [
        "parcellation/conversion/tests/data/**"
      ],
      "required_paths": [
        "parcellation/conversion/tests/data/WIP_dti_ax_601.nii.gz",
        "parcellation/conversion/tests/data/CONVERTED_WIP_dti_ax_601.nii.gz",
        "parcellation/conversion/tests/data/Multi_WIP_dti_ax_601.nii.gz",
        "parcellation/conversion/tests/data/Repeated_WIP_dti_ax_601.nii.gz"
      ]
    },
    "all": {
      "description": "Every Git LFS object tracked by this repository.",
      "all_lfs": true
    }
  }
}

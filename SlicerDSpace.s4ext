# SlicerDSpace extension description for Slicer ExtensionsIndex submission.
# Keep `depends` synchronized with top-level CMakeLists.txt EXTENSION_DEPENDS.
scm git
scmurl https://github.com/ChengjinLii/SlicerDSpace.git
scmrevision main
depends SlicerDMRI PyTorch
build_subdirectory .
homepage https://github.com/ChengjinLii/SlicerDSpace
category Diffusion
contributors Chengjin Li
description Integrated diffusion MRI workflows for anatomical reconstruction, tractography, bundle analysis, and structural connectivity.
iconurl https://raw.githubusercontent.com/ChengjinLii/SlicerDSpace/main/Resources/Icons/SlicerDSpace.png
screenshoturls https://raw.githubusercontent.com/ChengjinLii/SlicerDSpace/main/docs/images/slicerdds-compact-en.png
enabled 1
